# KnowledgePilot Configuration

# General Settings
APP_NAME=KnowledgePilot
ENV=development
LOG_LEVEL=INFO

# LLM Configuration
# Supported providers: gemini, openai, ollama
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
# Or OpenAI:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=your_openai_api_key

GEMINI_API_KEY=your_gemini_api_key_here

# Embeddings Configuration
# Options: local (sentence-transformers), gemini, openai
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vector Database (Qdrant)
# For local persistent disk mode (no docker required):
QDRANT_MODE=local
QDRANT_STORAGE_PATH=./qdrant_db
# For remote/docker mode:
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Relational Database
DATABASE_URL=sqlite:///./knowledgepilot.db

# Web Research Settings
ENABLE_WEB_RESEARCH=true

# Storage Directories
DOCUMENTS_DIR=./documents
REPORTS_DIR=./generated_reports
